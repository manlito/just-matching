# Usage: cmake -DOUT=<file.cpp> "-DMODELS=<name=path|name=path>" -P embed.cmake
# Writes a C++ file that holds each weights file as a byte array, with #embed: the files are tens of MB, too
# large for a hex dump in the source. The compiler reads them; a change to one rebuilds the generated file
# (OBJECT_DEPENDS in CMakeLists.txt).
set(code "// Generated by cmake/embed.cmake. Do not edit.\n#include <cstddef>\n#include <string>\n\n")
set(blobs "")
set(lookup "")
set(i 0)
string(REPLACE "|" ";" MODELS "${MODELS}")
foreach(entry IN LISTS MODELS)
  string(REPLACE "=" ";" pair "${entry}")
  list(GET pair 0 name)
  list(GET pair 1 path)
  string(APPEND blobs "alignas(64) const unsigned char blob${i}[] = {\n#embed \"${path}\"\n};\n")
  string(APPEND lookup "  if (model == \"${name}\") { *data = blob${i}; *size = sizeof(blob${i}); return true; }\n")
  math(EXPR i "${i} + 1")
endforeach()
if(i GREATER 0)
  string(APPEND code "#if !defined(__has_embed)\n#error \"JMT_EMBED_WEIGHTS needs a compiler with #embed (Clang 19, GCC 15)\"\n#endif\n")
  string(APPEND code "#if defined(__clang__)\n#pragma clang diagnostic ignored \"-Wc23-extensions\"\n#endif\n")
  string(APPEND code "namespace {\n${blobs}}  // namespace\n\n")
endif()
string(APPEND code "namespace jmt {\n\nbool embedded_weights(const std::string& model, const void** data, size_t* size) {\n")
string(APPEND code "  (void)model; (void)data; (void)size;\n${lookup}  return false;\n}\n\n}  // namespace jmt\n")
file(WRITE "${OUT}" "${code}")
