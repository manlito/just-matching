# Usage: cmake -DIN=<file> -DOUT=<file.cpp> -DNAME=<symbol> -P embed_text.cmake
# Writes a C++ file that holds a text file (shader source) as a null-terminated char array.
file(READ "${IN}" text)
set(delim "jmt_msl")
string(FIND "${text}" ")${delim}\"" clash)
if(NOT clash EQUAL -1)
  message(FATAL_ERROR "${IN} contains the raw string delimiter")
endif()
file(WRITE "${OUT}" "// Generated by cmake/embed_text.cmake from ${IN}. Do not edit.\nextern const char ${NAME}[];\nconst char ${NAME}[] = R\"${delim}(${text})${delim}\";\n")
